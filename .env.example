# ============================================
# GENERAL
# ============================================

# Root directory for all datasets
DATASETS_DIR=Datasets


# ============================================
# AUGMENTATION - Data augmentation paths
# ============================================

# Source directory containing training data (train/images and train/labels)
AUG_SOURCE_DIR=Datasets/splited_dataset/train

# Destination directory for augmented images
AUG_TARGET_DIR=Datasets/augmented_train_dataset

# Default paths for augmentation utilities
AUG_IMG_DIR=Datasets/augmented_train_dataset/images
AUG_LABEL_DIR=Datasets/augmented_train_dataset/labels

# Subdirectory names for images and labels (usually 'images' and 'labels')
AUG_IMAGES_SUBDIR=images
AUG_LABELS_SUBDIR=labels

# ============================================
# AUGMENTATION - Performance settings
# ============================================

# Multiprocessing mode: auto (detect), enabled, disabled
# auto: enables multiprocessing if more than 1 CPU core available
AUG_MULTIPROCESSING=auto

# Number of worker processes: auto (smart detection), or specific number (1-N)
# auto strategy:
#   - <=2 cores: 1 worker (sequential)
#   - <=4 cores: cores-1 (leave 1 core free for OS)
#   - >4 cores: percentage of cores based on AUG_CPU_USAGE
AUG_WORKERS=auto

# CPU usage percentage when using auto workers (0.5-1.0)
# Determines how many cores to use (e.g., 0.75 = 75% of cores)
# Recommended: 0.75 for personal machines, 0.50 for shared servers
AUG_CPU_USAGE=0.75


# ============================================
# SPLITTING - Dataset splitting configuration
# ============================================

# Directories for positive images/labels (with detected drones)
SPLIT_POSITIVE_IMAGES_DIR=Datasets/dataset/images
SPLIT_POSITIVE_LABELS_DIR=Datasets/dataset/labels

# Directories for negative images/labels (without drones)
SPLIT_NEGATIVE_IMAGES_DIR=Datasets/dataset/negatives_images
SPLIT_NEGATIVE_LABELS_DIR=Datasets/dataset/negatives_labels

# Output directory for the split dataset (train/val/test)
SPLIT_OUTPUT_DIR=Datasets/splited_dataset


# ============================================
# TRAIN - YOLO training parameters
# ============================================

# Base model to load (yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt)
TRAIN_MODEL=yolov8s.pt

# YOLO dataset configuration file
TRAIN_DATA_YAML=data.yaml

# Training hyperparameters
TRAIN_EPOCHS=5              # Number of training epochs
TRAIN_IMGSZ=640             # Image size (640, 1280, etc.)
TRAIN_BATCH=16              # Batch size (adjust based on VRAM: 8GB->16, 16GB->32)
TRAIN_DEVICE=auto           # Device: 'auto' (detect), '0' (GPU 0), '1' (GPU 1), 'cpu', '0,1' (multi-GPU)
TRAIN_WORKERS=8             # Number of workers for data loading
TRAIN_CACHE=disk            # Cache type: 'ram', 'disk', false
TRAIN_AMP=true              # Mixed precision training (FP16) for GPU acceleration
TRAIN_PATIENCE=50           # Early stopping: stop if no improvement after N epochs
TRAIN_SAVE_PERIOD=5         # Save a checkpoint every N epochs


# ============================================
# PREDICT - Prediction and inference
# ============================================

# Path to the trained model (best weights)
PREDICT_MODEL_PATH=runs/detect/train/weights/best.pt

# Source of images for prediction (directory or single file)
PREDICT_SOURCE=Datasets/splited_dataset/val/images

# Device for prediction: auto (detect), cpu, 0, 1, 0,1 (multi-GPU)
# auto: automatically detects GPU and falls back to CPU if not available
PREDICT_DEVICE=auto

# Minimum confidence threshold for detections
PREDICT_CONF=0.25


# ============================================
# TEST - Evaluation on test set
# ============================================

# Path to the model to evaluate
MODEL_PATH=runs/detect/train/weights/best.pt

# YAML configuration file for the dataset
DATA_YAML_PATH=data.yaml

# Paths to the test set
TEST_IMAGES_PATH=Datasets/splited_dataset/test/images
TEST_LABELS_PATH=Datasets/splited_dataset/test/labels

# Device for evaluation
DEVICE=0

# Detection thresholds
CONF_THRESHOLD=0.25         # Minimum confidence threshold
IOU_THRESHOLD=0.45          # IoU threshold for NMS (Non-Maximum Suppression)

# Save results in JSON format
SAVE_JSON=false


# ============================================
# DISPLAYAPP - Next.js web application
# ============================================
# Note: Next.js variables must be in displayapp/.env.local
# Public variables (exposed to browser) must start with NEXT_PUBLIC_

# Backend API URL (for Python → Next.js connection)
DISPLAYAPP_API_URL=http://localhost:3000/api/detections

# Next.js server port
DISPLAYAPP_PORT=3000
